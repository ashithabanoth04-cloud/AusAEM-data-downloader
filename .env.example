# =============================================================================
# AWS CREDENTIALS & DEPLOYMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and insert your AWS account information below.
# =============================================================================

# AWS IAM Access Keys
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# AWS S3 Storage Bucket
S3_BUCKET=ausaem-wa-data
RAW_PREFIX=raw
PROCESSED_PREFIX=processed

# AWS ECS Fargate & ECR Container Configuration
ECR_REPO_NAME=ausaem-wa-worker
ECS_CLUSTER_NAME=ausaem-fargate-cluster
ECS_TASK_FAMILY=ausaem-downloader-task
ECS_EXECUTION_ROLE_NAME=ecsTaskExecutionRole

# Pipeline Runtime Defaults
WORKERS=4
OVERWRITE=false


# Example commands:
# 1. Process all AusAEM-WA survey areas:
# python ausem.py

# 2. Process a single survey:
# python ausem.py --survey Earaheedy

# 3. Force reprocessing:
# python ausem.py --force
